@layouts.main()
<div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">My Sales</h1>
    <p class="mt-1 text-sm text-base-content/60">{{ pgUsername }}{{ pgTown ? ' — ' + pgTown : '' }}</p>
  </div>
  <div class="flex gap-2">
    <a href="/dealer/sales-entries/create" class="btn btn-neutral shadow-sm">+ New Entry</a>
    <a href="/dealer/sales-entries/export" class="btn text-white shadow-sm" style="background-color:#217346">Export to Excel</a>
  </div>
</div>

<div class="overflow-x-auto rounded-2xl border border-base-300/60 bg-base-100 shadow-sm mt-4">
  <table class="table">
    <thead>
      <tr class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
        <th>Supplier</th><th>Customer</th><th>Model</th><th>Quantity</th><th>IMEI</th><th>Date</th><th></th>
      </tr>
    </thead>
    <tbody>
      @if(rows.length === 0)
        <tr><td colspan="7" class="py-10 text-center text-base-content/50">Vous n'avez pas encore de vente enregistrée</td></tr>
      @else
        @each(row in rows)
          <tr class="hover">
            <td>{{ row.supplierName }}</td>
            <td class="font-medium">{{ row.customerName }}</td>
            <td>{{ row.modelName }}</td>
            <td>{{ row.quantity }}</td>
            <td class="text-base-content/60">{{ row.imei }}</td>
            <td class="text-base-content/60">{{ row.createdAt }}</td>
            <td class="flex gap-1">
              <a href="/dealer/sales-entries/{{ row.entryId }}/edit" class="btn btn-ghost btn-sm">Edit</a>
              <form action="/dealer/sales-entries/{{ row.entryId }}/delete" method="POST" onsubmit="return confirm('Delete this entry?')">
                {{ csrfField() }}
                <button type="submit" class="btn btn-ghost btn-sm text-error">Delete</button>
              </form>
            </td>
          </tr>
        @end
      @end
    </tbody>
  </table>
</div>
@end
