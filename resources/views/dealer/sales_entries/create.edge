@layouts.main()
<h1 class="text-2xl font-bold mb-4">New Sales Entry</h1>
<form action="/dealer/sales-entries" method="POST" class="max-w-lg">
  {{ csrfField() }}
  <input type="text" name="customer_name" placeholder="Customer name" class="input input-bordered w-full mb-2" required>
  <input type="text" name="supplier_name" placeholder="Supplier" class="input input-bordered w-full mb-2">
  <input type="text" name="town_name" placeholder="Town (e.g. Douala)" class="input input-bordered w-full mb-4" required>
  <div id="lines-container">
    <div class="line-block border rounded p-3 mb-2">
      <input type="text" name="lines[0][marketing_name]" placeholder="Device model (e.g. A07)" class="input input-bordered w-full mb-2" required>
      <input type="text" name="lines[0][memory]" placeholder="Memory (e.g. 64GB/4GB)" class="input input-bordered w-full mb-2" required>
      <input type="text" name="lines[0][imei]" placeholder="IMEI (optional)" class="input input-bordered w-full mb-2">
      <input type="number" name="lines[0][quantity]" placeholder="Quantity" class="input input-bordered w-full" required>
    </div>
  </div>
  <button type="button" id="add-line-btn" class="btn btn-outline btn-sm w-full mb-4">+ Add another device</button>
  <button type="submit" class="btn btn-primary w-full">Submit</button>
</form>
<script>
  (function () {
    var container = document.getElementById('lines-container')
    var addBtn = document.getElementById('add-line-btn')
    var lineIndex = 1
    addBtn.addEventListener('click', function () {
      var block = document.createElement('div')
      block.className = 'line-block border rounded p-3 mb-2'
      block.innerHTML =
        '<input type="text" name="lines[' + lineIndex + '][marketing_name]" placeholder="Device model" class="input input-bordered w-full mb-2" required>' +
        '<input type="text" name="lines[' + lineIndex + '][memory]" placeholder="Memory" class="input input-bordered w-full mb-2" required>' +
        '<input type="text" name="lines[' + lineIndex + '][imei]" placeholder="IMEI (optional)" class="input input-bordered w-full mb-2">' +
        '<input type="number" name="lines[' + lineIndex + '][quantity]" placeholder="Quantity" class="input input-bordered w-full mb-2" required>' +
        '<button type="button" class="btn btn-error btn-xs remove-line-btn">Remove</button>'
      container.appendChild(block)
      lineIndex++
      block.querySelector('.remove-line-btn').addEventListener('click', function () {
        block.remove()
      })
    })
  })()
</script>
@end
