@layouts.main()
<div class="flex justify-center mt-20">
  <div class="card w-96 bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">Login</h2>
      @if(flashMessages.has('error'))
        <div class="alert alert-error">{{ flashMessages.get('error') }}</div>
      @end
      <form action="/login" method="POST">
        {{ csrfField() }}
        <input type="email" name="email" placeholder="Email" class="input input-bordered w-full mb-2" required>
        <input type="password" name="password" placeholder="Password" class="input input-bordered w-full mb-4" required>
        <button type="submit" class="btn btn-primary w-full">Login</button>
      </form>
    </div>
  </div>
</div>
<a href="/signup" class="link mt-2">No account? Sign up</a>
@end