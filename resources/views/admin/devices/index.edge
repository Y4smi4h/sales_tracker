@layouts.main()
<div class="mb-6 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Devices</h1>
    <p class="mt-1 text-sm text-base-content/60">Catalogue des modèles d'appareils</p>
  </div>
  <a href="/admin/devices/create" class="btn btn-primary shadow-sm">+ New Device</a>
</div>
<div class="overflow-x-auto rounded-2xl border border-base-300/60 bg-base-100 shadow-sm">
  <table class="table">
    <thead>
      <tr class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
        <th>Marketing Name</th><th>Memory</th><th></th>
      </tr>
    </thead>
    <tbody>
      @if(devices.length === 0)
        <tr><td colspan="3" class="py-10 text-center text-base-content/50">Aucun appareil pour le moment</td></tr>
      @else
        @each(device in devices)
          <tr class="hover">
            <td class="font-medium">{{ device.marketingName }}</td>
            <td>{{ device.memory }}</td>
            <td>
              <form action="/admin/devices/{{ device.id }}/delete" method="POST" onsubmit="return confirm('Delete this device?')">
                {{ csrfField() }}
                <button type="submit" class="btn btn-xs btn-error">Delete</button>
              </form>
            </td>
          </tr>
        @end
      @end
    </tbody>
  </table>
</div>
@end
