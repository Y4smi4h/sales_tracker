@layouts.main()
<h1 class="text-2xl font-bold mb-4">Edit User</h1>
<form action="/admin/users/{{ user.id }}/update" method="POST" class="max-w-lg">
  {{ csrfField() }}
  <input type="text" name="username" value="{{ user.username }}" placeholder="Username" class="input input-bordered w-full mb-2" required>
  <input type="email" name="email" value="{{ user.email }}" placeholder="Email" class="input input-bordered w-full mb-2" required>
  <input type="password" name="password" placeholder="New password (leave blank to keep current)" class="input input-bordered w-full mb-2">
  <select name="role" class="select select-bordered w-full mb-4" required>
    <option value="dealer" {{ user.role === 'dealer' ? 'selected' : '' }}>PG</option>
    <option value="admin" {{ user.role === 'admin' ? 'selected' : '' }}>Admin</option>
  </select>
  <button type="submit" class="btn btn-primary w-full">Save Changes</button>
</form>
@end