@layouts.main()
@if(flashMessages.has('success'))
  <div class="alert alert-success mb-4">{{ flashMessages.get('success') }}</div>
@end
<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-bold">Towns</h1>
  <a href="/admin/towns/create" class="btn btn-primary">New Town</a>
</div>
<table class="table w-full bg-base-100 shadow rounded">
  <thead><tr><th>Name</th><th>Region</th><th>Division</th><th></th></tr></thead>
  <tbody>
    @each(town in towns)
      <tr>
        <td>{{ town.townName }}</td>
        <td>{{ town.region }}</td>
        <td>{{ town.division }}</td>
        <td>
          <form action="/admin/towns/{{ town.id }}/delete" method="POST" onsubmit="return confirm('Delete this town?')">
            {{ csrfField() }}
            <button type="submit" class="btn btn-xs btn-error">Delete</button>
          </form>
        </td>
      </tr>
    @end
  </tbody>
</table>
@end