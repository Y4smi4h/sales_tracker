@layouts.main()
<div class="mb-8">
  <h1 class="text-2xl font-bold tracking-tight">Tableau de bord Admin</h1>
  <p class="mt-1 text-sm text-base-content/60">Vue d'ensemble de l'activité de vente</p>
</div>

<div class="grid grid-cols-2 gap-4 mb-8 md:grid-cols-4">
  <div class="card-hover rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>
    </div>
    <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Total Transactions</div>
    <div class="mt-1 text-3xl font-bold tracking-tight">{{ totalTransactions }}</div>
  </div>
  <div class="card-hover rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
    </div>
    <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Total Units Sold</div>
    <div class="mt-1 text-3xl font-bold tracking-tight">{{ totalUnits }}</div>
  </div>
  <div class="card-hover rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-5.13a4 4 0 11-8 0 4 4 0 018 0zm6 3a4 4 0 10-8 0"/></svg>
    </div>
    <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Active PG</div>
    <div class="mt-1 text-3xl font-bold tracking-tight">{{ activePG }}</div>
  </div>
  <div class="card-hover rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-5.13a4 4 0 11-8 0 4 4 0 018 0zm6 3a4 4 0 10-8 0"/></svg>
    </div>
    <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Total PG</div>
    <div class="mt-1 text-3xl font-bold tracking-tight">{{ totalPG }}</div>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 mb-8 md:grid-cols-3">
  <div class="rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Sales Today</div>
    <div class="mt-1 text-2xl font-bold tracking-tight">{{ todayUnits }}</div>
  </div>
  <div class="rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Sales This Week</div>
    <div class="mt-1 text-2xl font-bold tracking-tight">{{ weekUnits }}</div>
  </div>
  <div class="rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Sales This Month</div>
    <div class="mt-1 text-2xl font-bold tracking-tight">{{ monthUnits }}</div>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 mb-8 md:grid-cols-2">
  <div class="rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <h2 class="mb-3 font-semibold">Top Selling Models</h2>
    @if(topModels.length === 0)
      <p class="py-6 text-center text-sm text-base-content/50">Aucune vente pour le moment</p>
    @else
      <ul class="space-y-2">
        @each(item in topModels)
          <li class="flex items-center justify-between rounded-lg px-2 py-1.5 hover:bg-base-200/60">
            <span class="text-sm">{{ item.model }}</span>
            <span class="badge badge-primary badge-outline">{{ item.qty }}</span>
          </li>
        @end
      </ul>
    @end
  </div>

  <div class="rounded-2xl border border-base-300/60 bg-base-100 p-5 shadow-sm">
    <h2 class="mb-3 font-semibold">Sales Trend (last 14 days)</h2>
    <div class="flex items-end gap-1 h-32">
      @each(day in chartDays)
        <div class="flex-1 flex flex-col items-center justify-end h-full">
          <div class="w-full rounded-t bg-gradient-to-t from-primary to-accent" style="height: {{ (day.value / maxChartValue) * 100 }}%; min-height: 2px;" title="{{ day.label }}: {{ day.value }}"></div>
        </div>
      @end
    </div>
    <div class="flex gap-1 mt-1">
      @each(day in chartDays)
        <div class="flex-1 text-center text-[9px] text-base-content/40">{{ day.label }}</div>
      @end
    </div>
  </div>
</div>

<div class="flex flex-wrap gap-2">
  <a href="/admin/towns" class="btn btn-outline btn-sm">Towns</a>
  <a href="/admin/devices" class="btn btn-outline btn-sm">Devices</a>
  <a href="/admin/sales-entries" class="btn btn-outline btn-sm">All Sales</a>
  <a href="/admin/audit-logs" class="btn btn-outline btn-sm">Audit Logs</a>
  <a href="/admin/users" class="btn btn-outline btn-sm">Users</a>
</div>
@end
