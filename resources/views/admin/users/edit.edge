@layouts.main()
<div class="mx-auto max-w-xl">
  <div class="card border border-base-300/60 bg-base-100 shadow-sm">
    <div class="card-body">
      <h1 class="card-title text-xl">Edit User</h1>
      <p class="mb-2 text-sm text-base-content/60">Modifiez les informations de ce compte</p>
      <form action="/admin/users/{{ user.id }}/update" method="POST" class="space-y-3">
        {{ csrfField() }}
        <div>
          <label class="label pb-1"><span class="label-text">Username</span></label>
          <input type="text" name="username" value="{{ user.username }}" placeholder="Username" class="input input-bordered w-full" required>
        </div>
        <div>
          <label class="label pb-1"><span class="label-text">Email</span></label>
          <input type="email" name="email" value="{{ user.email }}" placeholder="vous@exemple.com" class="input input-bordered w-full" required>
        </div>
        <div>
          <label class="label pb-1"><span class="label-text">Password</span></label>
          <input type="password" name="password" placeholder="New password (leave blank to keep current)" class="input input-bordered w-full">
        </div>
        <div>
          <label class="label pb-1"><span class="label-text">Role</span></label>
          <select name="role" class="select select-bordered w-full" required>
            <option value="dealer" {{ user.role === 'dealer' ? 'selected' : '' }}>PG</option>
            <option value="admin" {{ user.role === 'admin' ? 'selected' : '' }}>Admin</option>
          </select>
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <a href="/admin/users" class="btn btn-ghost">Cancel</a>
          <button type="submit" class="btn btn-primary shadow-sm">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>
@end
