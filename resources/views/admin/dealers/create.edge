@layouts.main()
<div class="mx-auto max-w-2xl">
  <div class="card border border-base-300/60 bg-base-100 shadow-sm">
    <div class="card-body">
      <h1 class="card-title text-xl">New PG</h1>
      <p class="mb-2 text-sm text-base-content/60">Enregistrez un nouveau point de vente</p>
      <form action="/admin/dealers" method="POST" class="space-y-3">
        {{ csrfField() }}
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="label pb-1"><span class="label-text">Username (PG name)</span></label>
            <input type="text" name="username" placeholder="Username" class="input input-bordered w-full" required>
          </div>
          <div>
            <label class="label pb-1"><span class="label-text">Email</span></label>
            <input type="email" name="email" placeholder="vous@exemple.com" class="input input-bordered w-full" required>
          </div>
        </div>
        <div>
          <label class="label pb-1"><span class="label-text">Password</span></label>
          <input type="password" name="password" placeholder="••••••••" class="input input-bordered w-full" required>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="label pb-1"><span class="label-text">Shop name</span></label>
            <input type="text" name="shop_name" placeholder="Shop name" class="input input-bordered w-full" required>
          </div>
          <div>
            <label class="label pb-1"><span class="label-text">Category</span></label>
            <input type="text" name="dealer_category" placeholder="Category" class="input input-bordered w-full">
          </div>
        </div>
        <div>
          <label class="label pb-1"><span class="label-text">Town</span></label>
          <select name="town_id" class="select select-bordered w-full" required>
            <option disabled selected>Select town</option>
            @each(town in towns)
              <option value="{{ town.id }}">{{ town.townName }}</option>
            @end
          </select>
        </div>
        <div>
          <label class="label pb-1"><span class="label-text">Location</span></label>
          <input type="text" name="location" placeholder="Location" class="input input-bordered w-full">
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="label pb-1"><span class="label-text">Owner name</span></label>
            <input type="text" name="owner_name" placeholder="Owner name" class="input input-bordered w-full">
          </div>
          <div>
            <label class="label pb-1"><span class="label-text">Phone number</span></label>
            <input type="text" name="phone_number" placeholder="Phone number" class="input input-bordered w-full">
          </div>
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <a href="/admin/dealers" class="btn btn-ghost">Cancel</a>
          <button type="submit" class="btn btn-primary shadow-sm">Create PG</button>
        </div>
      </form>
    </div>
  </div>
</div>
@end
