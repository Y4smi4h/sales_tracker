<!DOCTYPE html>
<html lang="en" data-theme="mytheme">
<head>
  <meta charset="UTF-8">
  <title>{{ title ?? 'Sales Tracker' }}</title>
  @vite(['resources/css/app.css'])
</head>
<body class="min-h-screen bg-base-200">
  <nav class="navbar shadow-md px-6" style="background-color:#141b2d">
    <div class="flex-1 flex items-center gap-6">
      <a href="/" class="text-lg font-medium text-white">Sales Tracker</a>
      @if(auth.user && auth.user.role === 'admin')
        <a href="/admin/users" class="text-white text-sm opacity-80 hover:opacity-100">Users</a>
      @end
    </div>
    <div class="flex-none flex items-center gap-3">
      <label class="swap swap-rotate">
        <input type="checkbox" id="theme-toggle-checkbox">
        <svg class="swap-off h-5 w-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a1 1 0 011 1v2a1 1 0 11-2 0V3a1 1 0 011-1zm0 16a1 1 0 011 1v2a1 1 0 11-2 0v-2a1 1 0 011-1zm10-6a1 1 0 01-1 1h-2a1 1 0 110-2h2a1 1 0 011 1zM5 12a1 1 0 01-1 1H2a1 1 0 110-2h2a1 1 0 011 1zm12.66-6.66a1 1 0 010 1.42l-1.42 1.42a1 1 0 11-1.42-1.42l1.42-1.42a1 1 0 011.42 0zM7.76 16.24a1 1 0 010 1.42l-1.42 1.42a1 1 0 11-1.42-1.42l1.42-1.42a1 1 0 011.42 0zm10.9 1.42a1 1 0 01-1.42 0l-1.42-1.42a1 1 0 111.42-1.42l1.42 1.42a1 1 0 010 1.42zM6.34 7.76a1 1 0 01-1.42 0L3.5 6.34a1 1 0 111.42-1.42l1.42 1.42a1 1 0 010 1.42zM12 6a6 6 0 100 12 6 6 0 000-12z"/></svg>
        <svg class="swap-on h-5 w-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M21.64 13a1 1 0 00-1.05-.14 8.05 8.05 0 01-3.37.73 8.15 8.15 0 01-8.14-8.14 8.05 8.05 0 01.73-3.37 1 1 0 00-1.24-1.24A10.14 10.14 0 002 10.14 10 10 0 0011.86 20a10.14 10.14 0 007.87-3.72 1 1 0 00-.09-1.28z"/></svg>
      </label>
      @if(auth.user)
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium text-white" style="background:linear-gradient(135deg,#7f77dd,#d4537e)">
            {{ auth.user.email.slice(0,2).toUpperCase() }}
          </div>
          <span class="text-white text-sm hidden sm:inline">{{ auth.user.email }}</span>
        </div>
        <form action="/logout" method="POST">
          {{ csrfField() }}
          <button type="submit" class="btn btn-sm btn-outline text-white border-white/40 hover:bg-white/10">Logout</button>
        </form>
      @end
    </div>
  </nav>

  <main class="p-6">
    @if(flashMessages.has('success'))
      <div class="alert alert-success mb-4 shadow">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>{{ flashMessages.get('success') }}</span>
      </div>
    @end
    @if(flashMessages.has('error'))
      <div class="alert alert-error mb-4 shadow">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        <span>{{ flashMessages.get('error') }}</span>
      </div>
    @end
    {{{ await $slots.main() }}}
  </main>

  <script>
    (function () {
      var toggle = document.getElementById('theme-toggle-checkbox')
      var saved = localStorage.getItem('theme') || 'mytheme'
      document.documentElement.setAttribute('data-theme', saved)
      toggle.checked = saved === 'mytheme-dark'
      toggle.addEventListener('change', function () {
        var theme = toggle.checked ? 'mytheme-dark' : 'mytheme'
        document.documentElement.setAttribute('data-theme', theme)
        localStorage.setItem('theme', theme)
      })
    })()
  </script>
</body>
</html>