<!DOCTYPE html>
<html lang="en" data-theme="mytheme">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title ?? 'Sales Tracker' }}</title>
  @vite(['resources/css/app.css'])
</head>
<body class="min-h-screen bg-base-200">
  <nav class="sticky top-0 z-50 border-b border-white/5 px-6 shadow-md backdrop-blur" style="background-color:#141b2d">
    <div class="navbar mx-auto max-w-7xl px-0">
      <div class="flex-1 flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 text-white">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-sm font-bold" style="background:linear-gradient(135deg,#378add,#0c447c)">ST</span>
          <span class="text-lg font-semibold tracking-tight">Sales Tracker</span>
        </a>
        @if(auth.user && auth.user.role === 'admin')
          <a href="/admin/users" class="ml-2 rounded-full px-3 py-1 text-sm text-white/80 transition hover:bg-white/10 hover:text-white">Users</a>
        @end
      </div>
      <div class="flex-none flex items-center gap-3">
        <label class="swap swap-rotate rounded-full p-1.5 text-white/80 transition hover:bg-white/10 hover:text-white" aria-label="Toggle theme">
          <input type="checkbox" id="theme-toggle-checkbox">
          <svg class="swap-off h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a1 1 0 011 1v2a1 1 0 11-2 0V3a1 1 0 011-1zm0 16a1 1 0 011 1v2a1 1 0 11-2 0v-2a1 1 0 011-1zm10-6a1 1 0 01-1 1h-2a1 1 0 110-2h2a1 1 0 011 1zM5 12a1 1 0 01-1 1H2a1 1 0 110-2h2a1 1 0 011 1zm12.66-6.66a1 1 0 010 1.42l-1.42 1.42a1 1 0 11-1.42-1.42l1.42-1.42a1 1 0 011.42 0zM7.76 16.24a1 1 0 010 1.42l-1.42 1.42a1 1 0 11-1.42-1.42l1.42-1.42a1 1 0 011.42 0zm10.9 1.42a1 1 0 01-1.42 0l-1.42-1.42a1 1 0 111.42-1.42l1.42 1.42a1 1 0 010 1.42zM6.34 7.76a1 1 0 01-1.42 0L3.5 6.34a1 1 0 111.42-1.42l1.42 1.42a1 1 0 010 1.42zM12 6a6 6 0 100 12 6 6 0 000-12z"/></svg>
          <svg class="swap-on h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M21.64 13a1 1 0 00-1.05-.14 8.05 8.05 0 01-3.37.73 8.15 8.15 0 01-8.14-8.14 8.05 8.05 0 01.73-3.37 1 1 0 00-1.24-1.24A10.14 10.14 0 002 10.14 10 10 0 0011.86 20a10.14 10.14 0 007.87-3.72 1 1 0 00-.09-1.28z"/></svg>
        </label>
        @if(auth.user)
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="flex items-center gap-2 rounded-full px-2 py-1 transition hover:bg-white/10">
              <div class="flex h-8 w-8 items-center justify-center rounded-full text-xs font-medium text-white" style="background:linear-gradient(135deg,#7f77dd,#d4537e)">
                {{ auth.user.email.slice(0,2).toUpperCase() }}
              </div>
              <span class="hidden text-sm text-white sm:inline">{{ auth.user.email }}</span>
            </div>
            <div tabindex="0" class="dropdown-content menu z-10 mt-2 w-56 rounded-xl bg-base-100 p-2 shadow-lg border border-base-300/60">
              <div class="px-3 py-2 text-xs text-base-content/50">Signed in as</div>
              <div class="px-3 pb-2 text-sm font-medium truncate">{{ auth.user.email }}</div>
              <div class="divider my-0"></div>
              <form action="/logout" method="POST">
                {{ csrfField() }}
                <button type="submit" class="btn btn-ghost btn-sm w-full justify-start text-error">Logout</button>
              </form>
            </div>
          </div>
        @end
      </div>
    </div>
  </nav>

  <main class="mx-auto max-w-7xl p-6">
    @if(flashMessages.has('success'))
      <div class="alert alert-success mb-4 shadow-sm animate-fade-in">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>{{ flashMessages.get('success') }}</span>
      </div>
    @end
    @if(flashMessages.has('error'))
      <div class="alert alert-error mb-4 shadow-sm animate-fade-in">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        <span>{{ flashMessages.get('error') }}</span>
      </div>
    @end
    <div class="animate-fade-in">
      {{{ await $slots.main() }}}
    </div>
  </main>

  <script>
    (function () {
      var toggle = document.getElementById('theme-toggle-checkbox')
      var saved = localStorage.getItem('theme') || 'mytheme'
      document.documentElement.setAttribute('data-theme', saved)
      toggle.checked = saved === 'mytheme-dark'
      toggle.addEventListener('change', function () {
        var theme = toggle.checked ? 'mytheme-dark' : 'mytheme'
        document.documentElement.setAttribute('data-theme', theme)
        localStorage.setItem('theme', theme)
      })
    })()
  </script>
</body>
</html>
